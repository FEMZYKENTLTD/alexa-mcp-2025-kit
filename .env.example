# Example names only. Obtain real values from your host, Redis and OAuth provider.
# Never commit a populated .env file.
REDIS_URL=rediss://USERNAME:URL_ENCODED_PASSWORD@PRIVATE_REDIS_HOST:6379
JWKS_URL=https://auth.example.com/.well-known/jwks.json
MCP_ISSUER=https://auth.example.com/
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_AUDIENCE=https://mcp.example.com/mcp
MCP_ALLOWED_ORIGINS=https://app.example.com
PORT=3001
# Optional, only for the CLI audit of a protected URL; never commit a real token:
# MCP_AUDIT_BEARER_TOKEN=
